## .gitignore for .NET / ASP.NET Core / Visual Studio projects
## Based on github/gitignore VisualStudio.gitignore (trimmed to what's relevant)

# ---------------------------------------------------------------------------
# Visual Studio / IDE
# ---------------------------------------------------------------------------
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates
*.rsuser
*.userprefs

# VS Code (keep shared settings, ignore personal ones)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# JetBrains Rider
.idea/
*.sln.iml

# ---------------------------------------------------------------------------
# Build output
# ---------------------------------------------------------------------------
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Ll]og/
[Ll]ogs/
artifacts/

# Publish output
publish/
*.[Pp]ublish.xml
*.azurePubxml
*.pubxml
*.publishproj
PublishScripts/

# ---------------------------------------------------------------------------
# NuGet
# ---------------------------------------------------------------------------
*.nupkg
*.snupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/
*.nuget.props
*.nuget.targets
project.lock.json
project.fragment.lock.json

# ---------------------------------------------------------------------------
# Tests & coverage
# ---------------------------------------------------------------------------
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
*.trx
*.coverage
*.coveragexml
coverage*.json
coverage*.xml
coverage*.info
TestResults/

# ---------------------------------------------------------------------------
# Misc build / tooling caches
# ---------------------------------------------------------------------------
*_i.c
*_p.c
*_h.h
*.ilk
*.meta
*.obj
*.iobj
*.pch
*.pdb
*.ipdb
*.pgc
*.pgd
*.rsp
*.sbr
*.tlb
*.tli
*.tlh
*.tmp
*.tmp_proj
*.log
*.tlog
*.vspscc
*.vssscc
.builds
*.pidb
*.svclog
*.scc
*.cache
!*.[Cc]ache/
ScaffoldingReadMe.txt

# ---------------------------------------------------------------------------
# Local databases
# ---------------------------------------------------------------------------
*.mdf
*.ldf
*.ndf
*.db
*.sqlite
*.sqlite3

# ---------------------------------------------------------------------------
# Secrets & local environment config
# ---------------------------------------------------------------------------
# Use `dotnet user-secrets` for local secrets instead of committing them.
.env
.env.*
!.env.example
*.pfx
*.p12
*.key
appsettings.*.local.json
appsettings.Local.json
secrets.json

# App settings (contain connection strings / credentials)
appsettings.json
appsettings.Development.json
appsettings.Staging.json

# ---------------------------------------------------------------------------
# OS files
# ---------------------------------------------------------------------------
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
._*
